# ===============================================================================
# Environment Configuration for MultiversX Assets CDN
# ===============================================================================
# IMPORTANT: This file should NOT be committed to version control
# Add ".env" to your .gitignore if not already present
# ===============================================================================

# ===============================================================================
# GitHub Token (for private repository access)
# ===============================================================================
# Required if fetching OpenAPI specs from private GitHub repositories
# Generate a token at: Settings > Developer settings > Personal access tokens
# ===============================================================================
#GITHUB_TOKEN=YOUR_GITHUB_PERSONAL_ACCESS_TOKEN_HERE
GITHUB_TOKEN=
# ===============================================================================
# ISSUE 2: CORS Configuration
# ===============================================================================
# Set the domains that are allowed to make cross-origin requests to your API
# Separate multiple domains with commas
#
# Examples:
#   - Single domain: ALLOWED_ORIGIN=https://tools.multiversx-assets-cdn.com
#   - Multiple domains: ALLOWED_ORIGIN=https://dapp.multiversx.com,https://tools.multiversx-assets-cdn.com
#   - Allow all (NOT recommended): ALLOWED_ORIGIN=*
# ===============================================================================
ALLOWED_ORIGIN=http://localhost:3000,http://localhost:3200

# ===============================================================================
# ISSUE 3: Allowed Hosts Configuration
# ===============================================================================
# Set the hosts that are allowed to access this server
# Separate multiple hosts with commas
#
# Examples:
#   - Single domain: ALLOWED_HOSTS=tools.multiversx-assets-cdn.com
#   - Multiple domains: ALLOWED_HOSTS=tools.multiversx.com,dapp.multiversx.com
#   - Local development: ALLOWED_HOSTS=localhost,127.0.0.1
# ===============================================================================
ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com


# ===============================================================================
# Infrastructure Configuration
# ===============================================================================
PORT=3201
REPO_OWNER=Layavardhan011
REPO_NAME=demo-assets
BRANCH=main
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=mx_tools_secure_pass
