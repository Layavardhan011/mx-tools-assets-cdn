{
  "name": "swagger-ui",
  "version": "5.32.5",
  "main": "./dist/swagger-ui.js",
  "module": "./dist/swagger-ui-es-bundle-core.js",
  "exports": {
    "./dist/swagger-ui.css": "./dist/swagger-ui.css",
    "./dist/oauth2-redirect.html": "./dist/oauth2-redirect.html",
    "./dist/swagger-ui-standalone-preset": "./dist/swagger-ui-standalone-preset.js",
    ".": {
      "browser": {
        "import": "./dist/swagger-ui-es-bundle-core.js",
        "require": "./dist/swagger-ui.js"
      },
      "node": {
        "import": "./dist/swagger-ui-bundle.js",
        "require": "./dist/swagger-ui-es-bundle.js"
      },
      "default": {
        "import": "./dist/swagger-ui-bundle.js",
        "require": "./dist/swagger-ui-es-bundle.js"
      }
    }
  },
  "homepage": "https://github.com/swagger-api/swagger-ui",
  "repository": "git@github.com:swagger-api/swagger-ui.git",
  "contributors": [
    "(in alphabetical order)",
    "Anna Bodnia <anna.bodnia@gmail.com>",
    "Buu Nguyen <buunguyen@gmail.com>",
    "Josh Ponelat <jponelat@gmail.com>",
    "Kyle Shockey <kyleshockey@gmail.com>",
    "Robert Barnwell <robert@robertismy.name>",
    "Sahar Jafari <shr.jafari@gmail.com>",
    "Vladimir Gorej <vladimir.gorej@gmail.com>"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "automated-release": "release-it -VV --config ./release/.release-it.json",
    "clean": "rimraf ./dist",
    "proxy": "ts-node -r tsconfig-paths/register apps/api/src/main.ts",
    "proxy:prod": "node dist/apps/api/src/main.js",
    "proxy:cron": "ts-node -r tsconfig-paths/register apps/jobs-service/src/main.ts",
    "proxy:cron:prod": "node dist/apps/jobs-service/src/main.js",
    "build:api": "nest build api && nest build jobs-service && nest build common",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --max-warnings 0",
    "certs:gen": "node scripts/generate-certs.js",
    "test:unit": "cross-env NODE_ENV=test BABEL_ENV=commonjs BROWSERSLIST_ENV=node-development jest --config ./config/jest/jest.unit.config.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.22",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.22",
    "@nestjs/platform-express": "^11.1.22",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "=1.8.1",
    "express-rate-limit": "=8.5.1",
    "helmet": "=8.1.0",
    "js-yaml": "^4.1.0",
    "rate-limit-redis": "=5.0.0",
    "redis": "=5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@babel/core": "=7.29.0",
    "@babel/eslint-parser": "=7.28.6",
    "@babel/preset-env": "=7.29.5",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/testing": "^11.1.21",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "babel-jest": "=30.4.1",
    "cross-env": "=7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "=29.15.2",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.5",
    "jest": "=29.7.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "=4.2.0",
    "typescript": "^5.4.5"
  }
}
